# ─────────────────────────────────────────────────────────────────────────────
# JWT Auth Service — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="JWT Auth Service"
DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local development — created automatically on first run)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Postgres (production) — uncomment and fill in your connection string:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/authdb

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
